  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile and regional preferences, strictly isolated to owner."
    },
    "/events/{eventId}": {
      "schema": { "$ref": "#/entities/EventPlan" },
      "description": "Master event plan document owned by ownerId and accessible to authorized collaborators."
    },
    "/events/{eventId}/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/ExpenseItem" },
      "description": "Budget allocations and actual expenses for an event."
    },
    "/events/{eventId}/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/TimelineTask" },
      "description": "Timeline milestones and actionable tasks for an event."
    },
    "/events/{eventId}/vendors/{vendorId}": {
      "schema": { "$ref": "#/entities/VendorRecord" },
      "description": "Shortlisted and booked vendors for an event."
    },
    "/events/{eventId}/guests/{guestId}": {
      "schema": { "$ref": "#/entities/GuestRecord" },
      "description": "Guest list and RSVP records for an event (PII protected)."
    },
    "/events/{eventId}/collaborators/{collabUserId}": {
      "schema": { "$ref": "#/entities/CollaboratorRecord" },
      "description": "Collaborator RBAC permissions for an event."
    }
  }
}
