      ]
    },
    "CollaboratorRecord": {
      "title": "CollaboratorRecord",
      "description": "Collaborator membership grant under an event.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "eventId": {
          "type": "string",
          "minLength": 1,
